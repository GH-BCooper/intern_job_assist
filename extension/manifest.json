{
  "manifest_version": 3,
  "name": "Add to InternTrack",
  "version": "1.0.0",
  "description": "Grab the job posting you are looking at and open it prefilled in InternTrack.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "action": {
    "default_title": "Add this posting to InternTrack",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
